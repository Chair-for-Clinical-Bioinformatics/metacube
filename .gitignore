# pixi environments
.pixi/*
!.pixi/config.toml


# node
node_modules/
dist/
dist*/

# OS
.DS_Store

# large binary assets (tracked via LFS or downloaded separately)
*.glb

# IDEs
.vscode/
*.code-workspace

# python
__pycache__/
*.py[cod]
*.egg-info/


# build artifacts
python-pkg/src/*.egg-info/
build/
*.Rcheck/
metacube_*.tar.gz
tests/parity/fixture.csv
tests/
# scripts/: only the data builders for the bundled Census and ENCODE examples are
# published (they produced the data used in the publication); the rest are local.
scripts/*
!scripts/build_census_counts.py
!scripts/build_census_collections.py
!scripts/build_encode_counts.py
# regenerates the data snapshot in the root index.html (see README)
!scripts/update_dev.py
manuscript/
# local Python env for scripts/update_dev.py and the editable package
.venv/
